[Unit]
Description=RKNN annotation inference service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zql
Group=zql
WorkingDirectory=/home/zql/rknn_svc
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/zql/rknn_svc/rknn_svc.py --port 8077
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
